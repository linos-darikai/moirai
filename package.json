{
  "name": "moirai",
  "private": true,
  "description": "On-chain bot-arena strategy game on Solana",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:wasm": "wasm-pack build crates/civ-wasm --target web --out-dir pkg",
    "sync:idl": "cp target/idl/civ.json app/src/lib/solana/idl/civ.json && cp target/types/civ.ts app/src/lib/solana/idl/civ.ts",
    "dev": "pnpm --filter app dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "spike:magicblock": "NODE_OPTIONS=--no-experimental-strip-types ANCHOR_WALLET=${ANCHOR_WALLET:-$HOME/.config/solana/id.json} pnpm -C tests exec ts-mocha -p ./tsconfig.json -t 600000 devnet/magicblock-spike.ts"
  }
}
