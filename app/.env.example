# Copy to .env.local and adjust. Never commit .env files.

# Solana RPC for the base layer (devnet). MagicBlock's devnet RPC is real Solana devnet but far less
# rate-limited than the public one. See README "Which RPC, and why".
VITE_SOLANA_RPC_URL=https://rpc.magicblock.app/devnet

# Fallback: the public devnet RPC (rate-limits heavily).
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional private RPC (e.g. Helius) with a higher rate limit. Keep the key out of git.
# VITE_SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY_HERE
